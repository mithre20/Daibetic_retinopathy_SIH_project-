# AI DR Screen — Chatbot Assistant Environment Configuration

# Server Port
PORT=5000

# LLM Provider Configuration
# Supported providers: gemini (default), openai, anthropic, openrouter, fallback
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# Embedding & RAG Configuration
EMBEDDING_MODEL=tfidf-cosine
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.10

# Session & Memory
MAX_HISTORY_TURNS=6
DEFAULT_LANGUAGE=en
